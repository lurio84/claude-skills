# PUBLIC repo. Allowlist: ignore every top-level entry, publish only the skills listed below.
# A new skill (own or third-party) stays private until it is added here on purpose (audit F03, 2026-11-03).
/*
!/.gitignore
!/README.md
!/cerrar-chat/
!/grill-me/
!/revisar-uni/
!/revisar-vault/
!/sync/
!/task-progress/

# Inside published skills: local / temp files
*.log
*.tmp
.DS_Store
Thumbs.db

# Possible secrets (just in case)
.env
.env.*
*.key
*secret*
*token*

# Drafts
draft-*/
WIP-*/

# Mod types/tsconfig generated by Claude Code at load time
*/.claude-plugin/types/
*/tsconfig.json
